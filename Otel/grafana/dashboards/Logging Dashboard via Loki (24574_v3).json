      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Historical \"$searchable_pattern\" pattern matches distribution per service",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "direction": "backward",
                        "editorMode": "code",
                        "expr": "sum(rate(({service_name=~\"$container_name\", service_instance_id=~\"$instance\", service_name=~\"$service_name\"} |~ \"(?i)$searchable_pattern\" !~ \"(?i)$[[service_name]]_exclude\")[30s])) by (service_name)",
                        "legendFormat": "{{service_name}}",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
