                      },
                      "spec": {
                        "direction": "backward",
                        "editorMode": "code",
                        "expr": "sum(count_over_time(({service_name=~\"$container_name\", service_instance_id=~\"$instance\", service_name=~\"$service_name\"} |~ \"(?i)$searchable_pattern\" !~ \"(?i)$[[service_name]]_exclude\")[$__interval])) * 100 / sum(count_over_time(({service_name=~\"$container_name\", service_instance_id=~\"$instance\", service_name=~\"$service_name\"} !~ \"(?i)$[[service_name]]_exclude\")[$__interval]))",
