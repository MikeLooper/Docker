            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (id,source,target) (count_over_time({service_name=\"PilotMcpServer\"} | label_format selected=\"$correlationId\" | selected!=\"\" | CorrelationId=\"$correlationId\" or correlationId=\"$correlationId\" |= \"Sending HTTP request\" | scope_name=~\".*ClientHandler\" | label_format target=`{{ if contains \":11141\" .Uri }}Keycloak{{ else if or (contains \":11001\" .Uri) (contains \":11101\" .Uri) }}PilotApiDotNet{{ else if or (contains \":11201\" .Uri) (contains \":11301\" .Uri) }}PilotApiJava{{ else if or (contains \":11401\" .Uri) (contains \":11501\" .Uri) }}pilot-api-python{{ else }}{{ .Uri }}{{ end }}` | label_format source=\"PilotMcpServer\" | label_format id=`{{ .source }}->{{ .target }}` [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "calls"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (id,source,target) (count_over_time({service_name=\"PilotMcpServer\"} | label_format selected=\"$correlationId\" | selected!=\"\" | CorrelationId=\"$correlationId\" or correlationId=\"$correlationId\" |= \"request handler completed\" | label_format source=\"caller\",target=service_name | label_format id=`{{ .source }}->{{ .target }}` [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "calls"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (id,source,target) (count_over_time({service_name=~\".+\",service_name!=\"PilotMcpServer\"} | label_format selected=\"$correlationId\" | selected!=\"\" | CorrelationId=\"$correlationId\" or correlationId=\"$correlationId\" | label_format source=\"caller\",target=service_name | label_format id=`{{ .source }}->{{ .target }}` [$__auto])) unless on() sum(count_over_time({service_name=\"PilotMcpServer\"} | label_format selected=\"$correlationId\" | selected!=\"\" | CorrelationId=\"$correlationId\" or correlationId=\"$correlationId\" [1h]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "calls"
        }
      ],
      "description": "The components this correlation ID passed through, from their logs. Edge numbers are calls for PilotMcpServer's outgoing calls, and log entries for a request that came in directly.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
