          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "id",
                "source",
                "target",
                "mainstat"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "id": {
                "operation": "groupby",
                "aggregations": []
              },
              "source": {
                "operation": "groupby",
                "aggregations": []
              },
              "target": {
                "operation": "groupby",
                "aggregations": []
              },
              "mainstat": {
                "operation": "aggregate",
                "aggregations": [
                  "sum"
                ]
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "mainstat (sum)": "mainstat"
            }
          }
        }
