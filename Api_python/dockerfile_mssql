# Python runtime image for the SQL Server variant of the Pilot API
FROM python:3.12-slim
WORKDIR /app

# Declare the build-time arguments
ARG DEPLOY_DATE
ARG APP_PORT=54501

# Map them to environment variables so they persist in the image
ENV APP_DEPLOY_DATE=$DEPLOY_DATE
ENV APP_PORT=$APP_PORT
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# pyodbc requires the Microsoft ODBC Driver 18 and unixODBC.
# The repository package must match the Debian release of the base image, which changes over time.
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && . /etc/os-release \
    && curl -fsSL "https://packages.microsoft.com/config/debian/${VERSION_ID}/packages-microsoft-prod.deb" -o /tmp/packages-microsoft-prod.deb \
    && DEBIAN_FRONTEND=noninteractive dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm -f /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built wheel and the environment file from the build context
COPY . .

# Install the application and its dependencies from the wheel
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir /app/*.whl \
    && rm -f /app/*.whl

# Run as a non-root user
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE $APP_PORT

CMD ["sh", "-c", "exec uvicorn pilot_api.main:app --host 0.0.0.0 --port ${APP_PORT}"]
