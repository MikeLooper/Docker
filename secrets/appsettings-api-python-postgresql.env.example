APP_NAME=PilotApiPython
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON=true
DB_BACKEND=postgresql
DB_NAME=northwind
DB_CONNECT_TIMEOUT=30
DB_HOST=local-postgres
DB_PASSWORD=<postgres-dev-user-password>
DB_PORT=5432
DB_SCHEMA=pilot
DB_USER=DevUser
DB_TRUST_SERVER_CERTIFICATE=true
# Optional full override:
# DATABASE_URL=postgresql+psycopg://DevUser:<postgres-dev-user-password>@local-postgres:5432/northwind?connect_timeout=30&options=-csearch_path%3Dpilot
SHOW_ABOUT_CONFIG=false
