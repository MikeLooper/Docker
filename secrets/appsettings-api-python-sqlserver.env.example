APP_NAME=PilotApiPython
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON=true
DB_BACKEND=sqlserver
DB_NAME=NorthWind
DB_CONNECT_TIMEOUT=30
DB_HOST=local-mssql
DB_PASSWORD=<mssql-dev-user-password>
DB_PORT=1433
DB_SCHEMA=dbo
DB_USER=DevUser
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true
# Optional full override:
# DATABASE_URL=mssql+pyodbc://DevUser:<mssql-dev-user-password>@local-mssql:1433/NorthWind?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&timeout=30
SHOW_ABOUT_CONFIG=false
