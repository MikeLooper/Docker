# Secrets for Api_MsDab (Data API builder + MCP Inspector).
# Copy ms-dab.env.example to ms-dab.env and replace placeholder values.
# Values are single-quoted so Docker Compose does not interpolate '$'.
# Do not use single quotes inside a value.
MSSQL_DATABASE_PASSWORD='<DevUser password for local-mssql>'
POSTGRES_DATABASE_PASSWORD='<DevUser password for local-postgres>'
# Any long random string. Guards the MCP Inspector API and its auto-connect links.
MCP_INSPECTOR_API_TOKEN='<random token>'
