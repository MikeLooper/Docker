# Optional LLM settings for SkillSpector (Tooling\Docker-SkillSpector-builder.bat).
# Copy skillspector.env.example to skillspector.env, replace placeholder values,
# then rerun the builder (the file is passed to the container with --env-file).
# Without this file, scans run static-only (--no-llm) and skill contents stay local.
# With it, analyzable skill file contents are sent to the configured provider.
SKILLSPECTOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=<anthropic-api-key>
# Optional overrides:
# SKILLSPECTOR_MODEL=claude-opus-5-5
# SKILLSPECTOR_LOG_LEVEL=INFO
# SKILLSPECTOR_MAX_WORKFLOW_SECONDS=1080
