# Secrets for Api_python_with_claude (PythonAPIWithClaude).
# Copy api-python-with-claude.env.example to api-python-with-claude.env and replace placeholder values.
# Passed to the container at runtime by Compose (env_file); it is not copied into the image.
ANTHROPIC_API_KEY=<anthropic-api-key>
# Optional overrides (app defaults shown):
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_MAX_TOKENS=16000
# CLAUDE_EFFORT=medium
# LOG_LEVEL=INFO
